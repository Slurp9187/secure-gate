# Normalize all text files to LF in the repo, let Git handle platform endings
* text=auto

# Force specific files if needed (e.g., shell scripts must stay LF)
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
# Add more extensions as needed for your project

# Captured evidence: byte-for-byte custody. Never normalise these. The SHA-256 values
# recorded in docs/design/receipts/README.md are of these exact bytes, so a line-ending
# conversion on checkout would silently break verification on the platform that did it.
docs/design/receipts/** -text
